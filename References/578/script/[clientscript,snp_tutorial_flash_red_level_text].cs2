[clientscript,snp_tutorial_flash_red_level_text]
if (%varclient_654 < 100) {
    %varclient_654 = calc(%varclient_654 + 1);
}
if (%varclient_654 = 50) {
    if_setcolour(^white, interface_834:com_13);
}
if (%varclient_654 = 100) {
    if_setcolour(0xff2323, interface_834:com_13);
    %varclient_654 = 0;
}
